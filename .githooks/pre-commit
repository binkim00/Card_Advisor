#!/bin/sh
set -eu
if command -v python >/dev/null 2>&1; then
  exec python scripts/check-staged-secrets.py --audit-local
elif command -v py >/dev/null 2>&1; then
  exec py -3 scripts/check-staged-secrets.py --audit-local
fi
echo "Python 3 is required for the staged-secret check. See docs/DEVELOPMENT.md." >&2
exit 1
